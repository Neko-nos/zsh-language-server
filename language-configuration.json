{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z_0-9-]*",
  "indentationRules": {
    "increaseIndentPattern": "(^.*\\b(then|do|else|elif)\\b\\s*(#.*)?$)|(^.*[({]\\s*(#.*)?$)",
    "decreaseIndentPattern": "^\\s*(?:(?:fi|done|else|elif|esac)\\b|[})])"
  }
}
